      "author": "Florian Roth (Nextron Systems)",
      "level": "high",
      "status": "test",
      "description": "Detects events in which a history file gets deleted, e.g. the ~/bash_history to remove traces of malicious activity",
      "link": "https://github.com/SigmaHQ/sigma/blob/r2026-07-01/rules/linux/process_creation/proc_creation_lnx_susp_history_delete.yml",
      "selections": {
        "selection": [
          [
            {
              "field": "Image",
              "op": "endswith",
              "values": [
                "/rm",
                "/unlink",
                "/shred"
              ],
              "all": false
            }
          ]
        ],
        "selection_history": [
          [
            {
              "field": "CommandLine",
              "op": "contains",
              "values": [
                "/.bash_history",
                "/.zsh_history"
              ],
              "all": false
            }
          ],
          [
            {
              "field": "CommandLine",
              "op": "endswith",
              "values": [
                "_history",
                ".history",
                "zhistory"
              ],
              "all": false
            }
          ]
        ]
      },
      "condition": {
        "t": "of",
        "quant": "all",
        "pattern": "selection*"
      }
    },
