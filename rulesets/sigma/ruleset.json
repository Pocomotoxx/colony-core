                " ash",
                " bash",
                " bsh",
                " csh",
                " ksh",
                " pdksh",
                " sh",
                " tcsh",
                "/bin/ash",
                "/bin/bash",
                "/bin/bsh",
                "/bin/csh",
                "/bin/ksh",
                "/bin/pdksh",
                "/bin/sh",
                "/bin/tcsh",
                "/bin/zsh",
                "$IFSash",
                "$IFSbash",
                "$IFSbsh",
                "$IFScsh",
                "$IFSksh",
                "$IFSpdksh",
                "$IFSsh",
                "$IFStcsh",
                "$IFSzsh"
              ],
              "all": false
            }
          ]
        ]
      },
      "condition": {
        "t": "of",
        "quant": "all",
        "pattern": "selection_*"
      }
    },
