    {
      "id": "c6714a24-d7d5-4283-a36b-3ffd091d5f7e",
      "title": "Potential PHP Reverse Shell",
      "author": "@d4ns4n_",
      "level": "high",
      "status": "test",
      "description": "Detects usage of the PHP CLI with the \"-r\" flag which allows it to run inline PHP code. The rule looks for calls to the \"fsockopen\" function which allows the creation of sockets. Attackers often leverage this in combination with functions such as \"exec\" or \"fopen\" to initiate a reverse shell connection.",
      "link": "https://github.com/SigmaHQ/sigma/blob/r2026-07-01/rules/linux/process_creation/proc_creation_lnx_php_reverse_shell.yml",
      "selections": {
        "selection": [
          [
            {
              "field": "Image",
              "op": "contains",
              "values": [
                "/php"
              ],
              "all": false
            },
            {
              "field": "CommandLine",
              "op": "contains",
              "values": [
                " -r ",
                "fsockopen"
              ],
              "all": true
            },
            {
              "field": "CommandLine",
              "op": "contains",
              "values": [
                "ash",
                "bash",
                "bsh",
                "csh",
                "ksh",
                "pdksh",
                "sh",
                "tcsh",
                "zsh"
              ],
              "all": false
            }
          ]
        ]
      },
      "condition": {
        "t": "sel",
        "name": "selection"
      }
    },
    {
      "id": "32e62bc7-3de0-4bb1-90af-532978fe42c0",
      "title": "Python Reverse Shell Execution Via PTY And Socket Modules",
      "author": "@d4ns4n_, Nasreddine Bencherchali (Nextron Systems)",
      "level": "high",
      "status": "test",
      "description": "Detects the execution of python with calls to the socket and pty module in order to connect and spawn a potential reverse shell.",
      "link": "https://github.com/SigmaHQ/sigma/blob/r2026-07-01/rules/linux/process_creation/proc_creation_lnx_python_reverse_shell.yml",
      "selections": {
        "selection": [
          [
            {
              "field": "Image",
              "op": "contains",
              "values": [
                "python"
              ],
              "all": false
            },
            {
              "field": "CommandLine",
              "op": "contains",
              "values": [
                " -c ",
                "import",
                "pty",
                "socket",
                "spawn",
                ".connect"
              ],
              "all": true
            }
          ]
        ]
      },
      "condition": {
        "t": "sel",
        "name": "selection"
      }
    },
    {
      "id": "2d2f44ff-4611-4778-a8fc-323a0e9850cc",
      "title": "Inline Python Execution - Spawn Shell Via OS System Library",
      "author": "Li Ling, Andy Parkidomo, Robert Rakowski, Blake Hartstein (Bloomberg L.P.)",
      "level": "high",
      "status": "test",
      "description": "Detects execution of inline Python code via the \"-c\" in order to call the \"system\" function from the \"os\" library, and spawn a shell.",
      "link": "https://github.com/SigmaHQ/sigma/blob/r2026-07-01/rules/linux/process_creation/proc_creation_lnx_python_shell_os_system.yml",
      "selections": {
        "selection_img": [
          [
            {
              "field": "Image",
              "op": "endswith",
              "values": [
                "/python",
                "/python2",
                "/python3"
              ],
              "all": false
            }
          ],
          [
            {
              "field": "Image",
              "op": "contains",
              "values": [
                "/python2.",
                "/python3."
              ],
              "all": false
            }
          ]
        ],
        "selection_cli": [
          [
            {
              "field": "CommandLine",
              "op": "contains",
              "values": [
                " -c ",
                "os.system("
              ],
              "all": true
            },
            {
              "field": "CommandLine",
              "op": "contains",
              "values": [
                "/bin/bash",
                "/bin/dash",
                "/bin/fish",
                "/bin/sh",
                "/bin/zsh"
              ],
              "all": false
            }
          ]
        ]
      },
      "condition": {
        "t": "of",
        "quant": "all",
        "pattern": "selection_*"
      }
    },
    {
      "id": "8737b7f6-8df3-4bb7-b1da-06019b99b687",
      "title": "Shell Invocation Via Ssh - Linux",
      "author": "Li Ling, Andy Parkidomo, Robert Rakowski, Blake Hartstein (Bloomberg L.P.)",
      "level": "high",
      "status": "test",
      "description": "Detects the use of the \"ssh\" utility to execute a shell. Such behavior may be associated with privilege escalation, unauthorized command execution, or to break out from restricted environments.",
      "link": "https://github.com/SigmaHQ/sigma/blob/r2026-07-01/rules/linux/process_creation/proc_creation_lnx_ssh_shell_execution.yml",
      "selections": {
        "selection_img": [
          [
            {
              "field": "Image",
              "op": "endswith",
              "values": [
                "/ssh"
              ],
              "all": false
            },
            {
              "field": "CommandLine",
              "op": "contains",
              "values": [
                "ProxyCommand=;",
                "permitlocalcommand=yes",
                "localhost"
              ],
              "all": false
            }
          ]
        ],
        "selection_cli": [
          [
            {
              "field": "CommandLine",
              "op": "contains",
              "values": [
                "/bin/bash",
                "/bin/dash",
                "/bin/fish",
                "/bin/sh",
                "/bin/zsh",
                "sh 0<&2 1>&2",
                "sh 1>&2 0<&2"
              ],
              "all": false
            }
          ]
        ]
      },
      "condition": {
        "t": "of",
        "quant": "all",
        "pattern": "selection_*"
      }
    },
    {
      "id": "1182f3b3-e716-4efa-99ab-d2685d04360f",
