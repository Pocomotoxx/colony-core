    {
      "id": "3fcc9b35-39e4-44c0-a2ad-9e82b6902b31",
      "title": "Syslog Clearing or Removal Via System Utilities",
      "author": "Max Altgelt (Nextron Systems), Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research), MSTIC",
      "level": "high",
      "status": "test",
      "description": "Detects specific commands commonly used to remove or empty the syslog. Which is a technique often used by attacker as a method to hide their tracks",
      "link": "https://github.com/SigmaHQ/sigma/blob/r2026-07-01/rules/linux/process_creation/proc_creation_lnx_clear_syslog.yml",
      "selections": {
        "selection_file": [
          [
            {
              "field": "CommandLine",
              "op": "contains",
              "values": [
                "/var/log/syslog"
              ],
              "all": false
            }
          ]
        ],
        "selection_command_rm": [
          [
            {
              "field": "Image",
              "op": "endswith",
              "values": [
                "/rm"
              ],
              "all": false
            },
            {
              "field": "CommandLine",
              "op": "contains",
              "values": [
                " -r ",
                " -f ",
                " -rf ",
                "/var/log/syslog"
              ],
              "all": false
            }
          ]
        ],
        "selection_command_unlink": [
          [
            {
              "field": "Image",
              "op": "endswith",
              "values": [
                "/unlink"
              ],
              "all": false
            }
          ]
        ],
        "selection_command_mv": [
          [
            {
              "field": "Image",
              "op": "endswith",
              "values": [
                "/mv"
              ],
              "all": false
            }
          ]
        ],
        "selection_command_truncate": [
          [
            {
              "field": "Image",
              "op": "endswith",
              "values": [
                "/truncate"
              ],
              "all": false
            },
            {
              "field": "CommandLine",
              "op": "contains",
              "values": [
                "0 ",
                "/var/log/syslog"
              ],
              "all": true
            },
            {
              "field": "CommandLine",
              "op": "contains",
              "values": [
                "-s ",
                "-c ",
                "--size"
              ],
              "all": false
            }
          ]
        ],
        "selection_command_ln": [
          [
            {
              "field": "Image",
              "op": "endswith",
              "values": [
                "/ln"
              ],
              "all": false
            },
            {
              "field": "CommandLine",
              "op": "contains",
              "values": [
                "/dev/null ",
                "/var/log/syslog"
              ],
              "all": true
            },
            {
              "field": "CommandLine",
              "op": "contains",
              "values": [
                "-sf ",
                "-sfn ",
                "-sfT "
              ],
              "all": false
            }
          ]
        ],
        "selection_command_cp": [
          [
            {
              "field": "Image",
              "op": "endswith",
              "values": [
                "/cp"
              ],
              "all": false
            },
            {
              "field": "CommandLine",
              "op": "contains",
              "values": [
                "/dev/null"
              ],
              "all": false
            }
          ]
        ],
        "selection_command_shred": [
          [
            {
              "field": "Image",
              "op": "endswith",
              "values": [
                "/shred"
              ],
              "all": false
            },
            {
              "field": "CommandLine",
              "op": "contains",
              "values": [
                "-u "
              ],
              "all": false
            }
          ]
        ],
        "selection_unique_other": [
          [
            {
              "field": "CommandLine",
              "op": "contains",
              "values": [
                " > /var/log/syslog",
                " >/var/log/syslog",
                " >| /var/log/syslog",
                ": > /var/log/syslog",
                ":> /var/log/syslog",
                ":>/var/log/syslog",
                ">|/var/log/syslog"
              ],
              "all": false
            }
          ]
        ],
        "selection_unique_journalctl": [
          [
            {
              "field": "CommandLine",
              "op": "contains",
              "values": [
                "journalctl --vacuum",
                "journalctl --rotate"
              ],
              "all": false
            }
          ]
        ]
      },
      "condition": {
        "t": "or",
        "l": {
          "t": "and",
          "l": {
            "t": "sel",
            "name": "selection_file"
          },
          "r": {
            "t": "of",
            "quant": "one",
            "pattern": "selection_command_*"
          }
        },
        "r": {
          "t": "of",
          "quant": "one",
          "pattern": "selection_unique_*"
        }
      }
    },
    {
