                "/nc",
                "/ncat"
              ],
              "all": false
            }
          ]
        ],
        "selection_flags": [
          [
            {
              "field": "CommandLine",
              "op": "contains",
              "values": [
                " -c ",
                " -e "
              ],
              "all": false
            }
          ]
        ],
        "selection_shell": [
          [
            {
              "field": "CommandLine",
              "op": "contains",
